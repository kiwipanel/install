#!/bin/bash
######################################################################
#                  KiwiPanel - a LOMP stack on Linux                 #
#                                                                    #
#                Author: Vuong Nguyen and contributors               #
#                  Website: https://kiwipanel.org                    #
#                             @since: 2025                           #
#              Please do not remove copyright. Thanks!               #
#  Please do not copy under any circumstance for commercial reason!  #
######################################################################

######################################################################
# KiwiPanel Installer v0.1.5
# To install KiwiPanel copy the following instruction and paste to the terminal:
# Quick Install (copy and paste to terminal):
# bash <(curl -fsSL https://raw.githubusercontent.com/kiwipanel/install/main/install)
#
# Or download first:
# curl -sLO https://raw.githubusercontent.com/kiwipanel/install/main/install && chmod +x install && sudo bash install

# Parse before root checks, traps, logging, locks or helper loading.
INSTALL_STEPS=(base_system swap firewall ssl mariadb config panel ols finalize)
VERIFY_ONLY=0
READINESS_CHECK=0
STEPS_FILTER=""
FULL_INSTALL=1
for arg in "$@"; do
    case "$arg" in
        --verify-only)
            if [[ "$VERIFY_ONLY" == 1 ]]; then
                printf 'Invalid arguments: duplicate --verify-only\n' >&2; exit 2
            fi
            VERIFY_ONLY=1 ;;
        --readiness-check)
            if [[ "$READINESS_CHECK" == 1 ]]; then
                printf 'Invalid arguments: duplicate --readiness-check\n' >&2; exit 2
            fi
            READINESS_CHECK=1 ;;
        --steps=*)
            if [[ -n "$STEPS_FILTER" || -z "${arg#--steps=}" ]]; then
                printf 'Invalid arguments: empty or duplicate --steps\n' >&2; exit 2
            fi
            STEPS_FILTER="${arg#--steps=}" ;;
        *) printf 'Invalid argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done
if [[ "$READINESS_CHECK" == 1 ]]; then
    if [[ "$VERIFY_ONLY" == 1 || -n "$STEPS_FILTER" ]]; then
        printf 'Invalid arguments: --readiness-check cannot be combined with --verify-only or --steps\n' >&2
        exit 2
    fi
    # Delegate before prerequisites, root checks, traps, logs or helper loading.
    # Preserve the installed CLI output and status; never bootstrap or repair it.
    kiwipanel panel readiness
    exit $?
fi
if [[ -n "$STEPS_FILTER" ]]; then
    remaining="$STEPS_FILTER"
    seen=","
    while :; do
        step="${remaining%%,*}"
        case "$step" in
            base_system|swap|firewall|ssl|mariadb|config|panel|ols|finalize) ;;
            *) printf 'Invalid step selection: %s\n' "$STEPS_FILTER" >&2; exit 2 ;;
        esac
        if [[ "$seen" == *",$step,"* ]]; then
            printf 'Duplicate step: %s\n' "$step" >&2; exit 2
        fi
        seen+="$step,"
        [[ "$remaining" == *,* ]] || break
        remaining="${remaining#*,}"
    done
fi
StepSelected() { [[ -z "$STEPS_FILTER" || ",$STEPS_FILTER," == *",$1,"* ]]; }
for step in "${INSTALL_STEPS[@]}"; do
    StepSelected "$step" || FULL_INSTALL=0
done

# Dedicated observational probes. Never source release helpers here: even their
# health checks can log, create credential files, or invoke application startup.
# No SQL/HTTP requests (which can cause server-side logs), repairs or service actions.
ReadOnlyCheck() {
    local root="${KIWIPANEL_INSTALL_ROOT:-/opt/kiwipanel}"
    local secrets="${KIWIPANEL_SECRETS_FILE:-/etc/kiwipanel/secrets.env}"
    case "$1" in
        base_system) systemctl is-active --quiet cron || systemctl is-active --quiet crond ;;
        swap)
            swapon --show | grep -q '/' && return 0
            local ram
            ram=$(free -m | awk '/Mem:/ {print $2}') || return 1
            [[ "$ram" =~ ^[0-9]+$ ]] && (( ram > 4096 )) ;;
        firewall)
            # Inspect kernel rules directly: ufw status can initialize its log.
            if systemctl is-active --quiet firewalld; then
                firewall-cmd --query-port=8443/tcp >/dev/null || return 1
            else
                local rules
                rules=$(iptables-save -t filter) || return 1
                grep -qE '^-A INPUT .* -j ufw-before-input$|^-A INPUT -j ufw-before-input$' <<< "$rules" || return 1
                grep -qE '^-A ufw-user-input .*--dport 8443 .* -j ACCEPT$|^-A ufw-user-input .*--dport 8443 -j ACCEPT$' <<< "$rules" || return 1
            fi
            systemctl is-active --quiet fail2ban ;;
        ssl)
            [[ -s "$root/ssl/panel/kiwipanel.crt" && -s "$root/ssl/panel/kiwipanel.key" ]] &&
                openssl x509 -in "$root/ssl/panel/kiwipanel.crt" -checkend 0 -noout ;;
        mariadb)
            { systemctl is-active --quiet mariadb || systemctl is-active --quiet mysql ||
                systemctl is-active --quiet mysqld; } || return 1
            [[ -r "$secrets" ]] && grep -qE '^(DB_PASS|MARIADB_DB_PASSWORD)=.+' "$secrets" ;;
        config) [[ -s "$root/config/kiwipanel.toml" ]] ;;
        panel)
            [[ -f "${KIWIPANEL_SERVICE_UNIT:-/etc/systemd/system/kiwipanel.service}" &&
                -s "$root/meta/passcode" && -s "$root/meta/terminal_token" ]] &&
                systemctl is-active --quiet kiwipanel && systemctl is-active --quiet kiwipanel-agent ;;
        ols)
            [[ -d /usr/local/lsws ]] &&
                { systemctl is-active --quiet lsws || systemctl is-active --quiet lshttpd; } &&
                ss -tln | grep -q ':80 ' ;;
        finalize)
            [[ -s "$root/data/kiwipanel.db" ]] && systemctl is-active --quiet kiwipanel ;;
        *) return 1 ;;
    esac
}

VerifyReadOnly() {
    local step failed=0 checked=0
    for step in "${INSTALL_STEPS[@]}"; do
        StepSelected "$step" || continue
        checked=$((checked + 1))
        if ReadOnlyCheck "$step" >/dev/null 2>&1; then
            printf '%s: PASS (observational check)\n' "$step"
        else
            printf '%s: FAIL (required artifacts/service state unavailable)\n' "$step"
            failed=$((failed + 1))
        fi
    done
    printf 'Verification complete: %s checked, %s failed. No changes made.\n' "$checked" "$failed"
    [[ "$failed" == 0 ]]
}

ValidateStepPrerequisites() {
    local step dependency dependencies failed=0 checked=","
    for step in "${INSTALL_STEPS[@]}"; do
        StepSelected "$step" || continue
        # Transitive dependencies, in execution order. Never install omitted steps.
        case "$step" in
            firewall|mariadb|ols) dependencies="base_system" ;;
            config) dependencies="base_system mariadb" ;;
            panel) dependencies="base_system ssl mariadb config" ;;
            finalize) dependencies="base_system swap firewall ssl mariadb config panel ols" ;;
            *) dependencies="" ;;
        esac
        for dependency in $dependencies; do
            StepSelected "$dependency" && continue
            [[ "$checked" == *",$dependency,"* ]] && continue
            checked+="$dependency,"
            if ! ReadOnlyCheck "$dependency" >/dev/null 2>&1; then
                printf 'Missing prerequisite: %s (required by %s); include it in --steps or provision it first.\n' "$dependency" "$step" >&2
                failed=$((failed + 1))
            fi
        done
    done
    [[ "$failed" == 0 ]]
}

if [[ "$VERIFY_ONLY" == 1 ]]; then
    if VerifyReadOnly; then exit 0; else exit 1; fi
fi
if ! ValidateStepPrerequisites; then exit 1; fi

######################################################################
# Check for sudo/root privileges######################################
if [ "$(id -u)" -ne 0 ]; then
    echo "❌ You should install KiwiPanel as root or using sudo command."
    exit 1
fi

export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# Stop on error
set -euo pipefail

# Create log file
KIWIPANEL_DIR="/opt/kiwipanel"
LOG_DIR="$KIWIPANEL_DIR/logs"
LOG_FILE="$LOG_DIR/install.log"

function log() {
    local level="$1"
    shift
    local message="$*"
    local ts

    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    # Existing-install classification deliberately runs before installer-owned
    # directories are created. Logging becomes durable only after that gate.
    [[ -d "$LOG_DIR" ]] || return 0
    echo "$ts [$level] $message" >> "$LOG_FILE"
}

LogInfo()  { log INFO  "$@"; }
LogWarn()  { log WARN  "$@"; }
LogError() { log ERROR "$@"; }
LogDebug() { [[ "$DEBUG" == "1" ]] && log DEBUG "$@"; }

# Utilities ###########################################################
PrintGreen() {
    local GREEN=$'\e[0;32m'
    local NC=$'\e[0m'
    local content="$*"

    printf "%b%s%b\n" "$GREEN" "$content" "$NC"
    LogInfo "$content"
}

PrintInfo() {
    local CYAN=$'\e[0;36m'
    local NC=$'\e[0m'
    local content="$*"

    printf "\n%b%s%b\n" "$CYAN" "$content" "$NC"
    LogInfo "$content"
}

PrintWarn() {
    local YELLOW_BROWN=$'\e[38;5;179m'
    local NC=$'\e[0m'
    local content="$*"

    printf "%bWarning: %s%b\n" "$YELLOW_BROWN" "$content" "$NC"
    LogWarn "$content"
}

PrintRed() {
    local RED=$'\e[0;31m'
    local NC=$'\e[0m'
    local content="$*"

    printf "\n%bError: %s%b\n" "$RED" "$content" "$NC"
    LogError "$content"
}


DEBUG=${DEBUG:-0}
AUTO_UPGRADE=${AUTO_UPGRADE:-0}

function InitializeInstallerRuntime() {
    clear
    date

    if command -v locale-gen >/dev/null 2>&1; then
        locale-gen en_US.UTF-8 2>/dev/null || true
    fi

    mkdir -p "$LOG_DIR" || {
        echo "Failed to create log directory: $LOG_DIR"
        return 1
    }
    touch "$LOG_FILE" || {
        echo "Failed to create log file: $LOG_FILE"
        return 1
    }

    chmod 750 "$KIWIPANEL_DIR" "$LOG_DIR" # rwx for owner+group only; no access for others (security requirement)
    chmod 640 "$LOG_FILE"
}

# ==============================================================================
# Installer Singleton Lock
# ==============================================================================
# Keep the file descriptor open for the lifetime of this process. The kernel
# releases the advisory lock automatically on every exit path; the stable lock
# file must not be deleted to bypass an active lock.
readonly INSTALLER_LOCK_FILE="${KIWIPANEL_INSTALLER_LOCK_FILE:-/run/kiwipanel-installer.lock}"
readonly INSTALLER_LOCK_FD=200

function AcquireInstallerLock() {
    if ! command -v flock >/dev/null 2>&1; then
        PrintRed "flock is required to prevent concurrent installer execution"
        return 1
    fi

    if ! exec 200<>"$INSTALLER_LOCK_FILE"; then
        PrintRed "Failed to open installer lock file: $INSTALLER_LOCK_FILE"
        return 1
    fi

    if ! flock -n "$INSTALLER_LOCK_FD"; then
        PrintRed "Another KiwiPanel installer is already running."
        PrintRed "Wait for that process to finish; the lock is released automatically when it exits."
        return 1
    fi

    LogInfo "Installer lock acquired: file=$INSTALLER_LOCK_FILE pid=$$"
}


# ==============================================================================
# Step Runner Framework
# ==============================================================================
# Adds resume-after-interruption capability. Each install step is wrapped with
# run_step which tracks completion via marker files and verifies before skipping.
# The existing install functions are called unchanged — this is a thin wrapper.
# ==============================================================================

INSTALL_STATE_DIR="${KIWIPANEL_INSTALL_STATE_DIR:-/var/lib/kiwipanel/install.d}"
INSTALL_ROOT="${KIWIPANEL_INSTALL_ROOT:-/opt/kiwipanel}"
PANEL_SERVICE_UNIT="${KIWIPANEL_SERVICE_UNIT:-/etc/systemd/system/kiwipanel.service}"
STEP_TOTAL=9
STEP_CURRENT=0
# run_step "step_name" execute_function verify_function
run_step() {
    local name="$1"
    local execute_fn="$2"
    local verify_fn="$3"
    local state_file="$INSTALL_STATE_DIR/${name}.done"

    ((STEP_CURRENT++)) || true

    StepSelected "$name" || return 0

    local prefix="[${STEP_CURRENT}/${STEP_TOTAL}] ${name}"

    # If marked done, verify before skipping
    if [[ -f "$state_file" ]]; then
        if "$verify_fn" 2>/dev/null; then
            PrintGreen "${prefix} ✔ verified (skipped)"
            LogInfo "Step '$name': verified, skipped"
            return 0
        else
            PrintWarn "${prefix}: verification failed, re-running"
            LogWarn "Step '$name': was marked done but verification failed"
            rm -f "$state_file"
        fi
    fi

    # Execute
    PrintInfo "${prefix} ▶ running..."
    LogInfo "Step '$name': starting"
    local start_time
    start_time=$(date +%s)

    if "$execute_fn"; then
        # Verify after execution
        if "$verify_fn" 2>/dev/null; then
            # Atomic mark: write to tmp, then mv (survives power loss)
            if [[ "$name" == finalize && "$FULL_INSTALL" == 0 ]]; then
                PrintGreen "${prefix} ✔ selected step completed (partial installation)"
                return 0
            fi
            local tmp_file="${state_file}.tmp"
            date -u +"%Y-%m-%dT%H:%M:%SZ" > "$tmp_file"
            mv "$tmp_file" "$state_file"
            local elapsed=$(( $(date +%s) - start_time ))
            PrintGreen "${prefix} ✔ completed (${elapsed}s)"
            LogInfo "Step '$name': completed and verified (${elapsed}s)"
            return 0
        else
            PrintRed "${prefix}: executed but verification failed"
            LogError "Step '$name': executed but verification failed"
            return 1
        fi
    else
        PrintRed "${prefix}: execution failed"
        LogError "Step '$name': execution failed"
        return 1
    fi
}

# ==============================================================================
# Idempotent Primitives (used by verify functions)
# ==============================================================================

ensure_package_installed() {
    local pkg="$1"
    rpm -q "$pkg" &>/dev/null || dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'
}

ensure_service_active() {
    local svc="$1"
    systemctl is-active "$svc" &>/dev/null
}

ensure_user_exists() {
    local usr="$1"
    id "$usr" &>/dev/null
}

ensure_group_exists() {
    local grp="$1"
    getent group "$grp" >/dev/null
}

ensure_dir_exists() {
    local dir="$1"
    [[ -d "$dir" ]]
}

ensure_file_exists() {
    local file="$1"
    [[ -f "$file" ]]
}


function IsTrustedInstallStateDirectory() {
    local state_dir="$INSTALL_STATE_DIR"
    local identity=""

    [[ -d "$state_dir" && ! -L "$state_dir" ]] || return 1
    identity="$(stat -c '%u|%g|%a' -- "$state_dir" 2>/dev/null)" || return 1
    [[ "$identity" == "0|0|700" ]]
}

function HasDurableKiwipanelEvidence() {
    local evidence
    for evidence in \
        "$INSTALL_ROOT/meta/.installed" \
        "$INSTALL_ROOT/bin/kiwipanel" \
        "$INSTALL_ROOT/config/kiwipanel.toml" \
        "$PANEL_SERVICE_UNIT"; do
        [[ -e "$evidence" || -L "$evidence" ]] && return 0
    done

    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet kiwipanel.service 2>/dev/null; then
        return 0
    fi
    return 1
}

# Prints exactly one state: fresh, partial, installed, or conflict.
function ClassifyKiwipanelInstallation() {
    local state_dir="$INSTALL_STATE_DIR"
    local marker=""
    local marker_name=""
    local completed=0
    local started=0
    local unknown=0
    local known_steps=" base_system swap firewall ssl mariadb config panel ols finalize "

    if [[ -e "$state_dir" || -L "$state_dir" ]]; then
        if ! IsTrustedInstallStateDirectory; then
            printf '%s\n' "conflict"
            return 0
        fi

        # Durable completed-install evidence always wins. Step markers are
        # resumable only while no completed installation can be observed.
        if HasDurableKiwipanelEvidence; then
            printf '%s\n' "installed"
            return 0
        fi

        [[ -f "$state_dir/.installing" ]] && started=1
        shopt -s nullglob
        for marker in "$state_dir"/*.done "$state_dir"/*.done.tmp; do
            marker_name="$(basename "$marker")"
            marker_name="${marker_name%.tmp}"
            marker_name="${marker_name%.done}"
            if [[ "$known_steps" != *" $marker_name "* ]]; then
                unknown=1
                continue
            fi
            [[ "$marker" == *.done ]] && ((completed++)) || true
        done
        shopt -u nullglob

        if [[ -f "$state_dir/finalize.done" ]]; then
            printf '%s\n' "installed"
            return 0
        fi
        if (( completed >= STEP_TOTAL )); then
            printf '%s\n' "conflict"
            return 0
        fi
        if (( unknown == 1 )); then
            printf '%s\n' "conflict"
            return 0
        fi
        if (( started == 1 || completed > 0 )); then
            printf '%s\n' "partial"
            return 0
        fi
        # An empty trusted directory can remain after a failure before the
        # installer writes its explicit start marker. It carries no resume
        # provenance and no installation evidence, so treat it as fresh.
        printf '%s\n' "fresh"
        return 0
    fi

    if HasDurableKiwipanelEvidence; then
        printf '%s\n' "installed"
        return 0
    fi
    printf '%s\n' "fresh"
}

function PrintExistingInstallGuidance() {
    PrintRed "KiwiPanel is already installed on this VPS."
    PrintRed "The installer supports only a fresh installation or resuming an interrupted installation."
    PrintRed "It will not overwrite, reinstall, or upgrade an existing installation."
    PrintInfo "Check for updates with: kiwipanel panel update"
    PrintInfo "Apply an available update from: Dashboard > System > Update"
}

function CheckFreshInstall() {
    local state=""
    local completed=0
    state="$(ClassifyKiwipanelInstallation)"

    case "$state" in
        installed)
            PrintExistingInstallGuidance
            return 1
            ;;
        conflict)
            PrintRed "KiwiPanel installation artifacts or untrusted installer state already exist."
            PrintRed "Refusing to modify this VPS because a safe interrupted-install resume cannot be proven."
            PrintInfo "Inspect $INSTALL_STATE_DIR and /opt/kiwipanel, or restore the VPS from a known-good backup."
            return 1
            ;;
        partial)
            completed=$(find "$INSTALL_STATE_DIR" -maxdepth 1 -type f -name '*.done' 2>/dev/null | wc -l | tr -d '[:space:]')
            PrintWarn "Found interrupted installation ($completed/$STEP_TOTAL steps completed). Resuming..."
            return 0
            ;;
        fresh)
            PrintGreen "Welcome! Thanks for choosing KiwiPanel."
            return 0
            ;;
        *)
            PrintRed "Unable to classify KiwiPanel installation state safely."
            return 1
            ;;
    esac
}

function PreflightChecks() {
    PrintInfo "==> Running pre-flight checks..."
    # Internet check
    if ! curl -s --max-time 5 https://google.com >/dev/null; then
        PrintRed "No internet connection"
        exit 1
    fi

    local missing=()

    # Check binary dependencies (note: gpg is handled separately below)
    for cmd in curl wget unzip systemctl jq; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    # gpg: package name differs between distros
    if ! command -v gpg >/dev/null 2>&1; then
        if command -v apt >/dev/null 2>&1; then
            missing+=("gnupg")
        else
            missing+=("gnupg2")
        fi
    fi

    # ca-certificates: check via package manager, not command
    if command -v dpkg >/dev/null 2>&1; then
        dpkg -s ca-certificates &>/dev/null || missing+=("ca-certificates")
    elif command -v rpm >/dev/null 2>&1; then
        rpm -q ca-certificates &>/dev/null || missing+=("ca-certificates")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        PrintInfo "==> Installing missing dependencies: ${missing[*]}"
        if command -v apt >/dev/null 2>&1; then
            apt update -y
            apt install -y "${missing[@]}"
        elif command -v dnf >/dev/null 2>&1; then
            dnf install -y "${missing[@]}"
        elif command -v yum >/dev/null 2>&1; then
            yum install -y "${missing[@]}"
        else
            PrintRed "Unsupported package manager. Install manually: ${missing[*]}"
            exit 1
        fi
    fi
}

# Reject completed or ambiguous installations before downloads, extraction,
# helper sourcing, metadata changes, binary replacement, or service control.
if ! CheckFreshInstall; then
    exit 1
fi
if ! AcquireInstallerLock; then
    exit 1
fi
# Recheck after acquiring the lock to close the classification race.
if ! CheckFreshInstall; then exit 1; fi
trap 'LogError "Failed: command=\"$BASH_COMMAND\" line=$LINENO"' ERR
trap 'Cleanup 2>/dev/null || true' EXIT
InitializeInstallerRuntime
PreflightChecks


# Configuration########################################################
readonly KIWIPANEL_PORT=8443
kiwipanel_passcode=""
INSTALL_DIR="/opt/kiwipanel"
TMP_BINARY="/tmp/kiwipanel-binary"
TMP_AGENT_BINARY="/tmp/kiwipanel-agent-binary"
TMP_ZIP="/tmp/kiwipanel-scaffold.zip"
INSTALL_MARKER="/opt/kiwipanel/meta/.installed"

# OS Detection Variables (set by LoadOsRelease)
OS_ID=""
OS_VERSION_MAJOR=""
OS_LIKE=""
OS_NAME=""
LSWS_SERVICE=""

# ------------------------------------------------------------------------------
# Fetching install scripts
# ------------------------------------------------------------------------------

function IsValidSHA256Checksum() {
    [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

function ReadRequiredReleaseSHA256() {
    local release="$1"
    local field="$2"
    local checksum

    # `jq -r` would coerce numbers and booleans to text. Require a JSON string
    # before accepting its exact lower-case SHA-256 representation.
    checksum="$(jq -er --arg field "$field" '.[$field] | select(type == "string")' <<< "$release")" || return 1
    IsValidSHA256Checksum "$checksum" || return 1
    printf '%s\n' "$checksum"
}

function ReadRequiredReleaseString() {
    local release="$1"
    local field="$2"
    local value

    # Catalog identity and URLs must be actual non-empty JSON strings. Do not
    # let jq turn null, booleans, or numbers into apparently valid text.
    value="$(jq -er --arg field "$field" '.[$field] | select(type == "string" and length > 0)' <<< "$release")" || return 1
    printf '%s\n' "$value"
}

function IsValidReleaseVersion() {
    [[ "$1" =~ ^[0-9]+(\.[0-9]+){2}(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]]
}

function ValidateRequiredArtifactURLs() {
    local expected_base_url
    local expected_panel_url
    local expected_agent_url
    local expected_scaffold_url

    # Exact canonical URLs prevent a catalog record from combining assets from
    # tags, architectures, repositories, hosts, schemes, or paths. The explicit
    # equality check also rejects query strings, fragments, credentials, and
    # traversal/encoding variants instead of attempting unsafe URL rewriting.
    if ! IsValidReleaseVersion "${KIWIPANEL_VERSION:-}" || \
       [[ "${KIWIPANEL_OS:-}" != "linux" ]] || \
       [[ "${KIWIPANEL_ARCH:-}" != "amd64" && "${KIWIPANEL_ARCH:-}" != "arm64" ]]; then
        PrintRed "Release catalog has an invalid selected release identity"
        return 1
    fi

    expected_base_url="https://github.com/kiwipanel/install/releases/download/v${KIWIPANEL_VERSION}"
    expected_panel_url="${expected_base_url}/kiwipanel-linux-${KIWIPANEL_ARCH}"
    expected_agent_url="${expected_base_url}/kiwipanel-agent-linux-${KIWIPANEL_ARCH}"
    expected_scaffold_url="${expected_base_url}/kiwipanel-scaffold.zip"

    if [[ "${KIWIPANEL_DOWNLOAD_URL:-}" != "$expected_panel_url" || \
          "${KIWIPANEL_AGENT_DOWNLOAD_URL:-}" != "$expected_agent_url" || \
          "${KIWIPANEL_SCAFFOLD_URL:-}" != "$expected_scaffold_url" ]]; then
        PrintRed "Release catalog artifact URLs do not match the selected release identity"
        return 1
    fi
}

function ValidateSelectedReleaseIdentity() {
    local release="$1"
    local expected_version="$2"
    local expected_os="$3"
    local expected_arch="$4"
    local version
    local os
    local arch
    local panel_url
    local agent_url
    local scaffold_url

    version="$(ReadRequiredReleaseString "$release" "version")" || return 1
    os="$(ReadRequiredReleaseString "$release" "os")" || return 1
    arch="$(ReadRequiredReleaseString "$release" "arch")" || return 1
    panel_url="$(ReadRequiredReleaseString "$release" "download_url")" || return 1
    agent_url="$(ReadRequiredReleaseString "$release" "agent_download_url")" || return 1
    scaffold_url="$(ReadRequiredReleaseString "$release" "scaffold_url")" || return 1

    [[ "$version" == "$expected_version" && "$os" == "$expected_os" && "$arch" == "$expected_arch" ]] || return 1
    KIWIPANEL_VERSION="$version"
    KIWIPANEL_OS="$os"
    KIWIPANEL_ARCH="$arch"
    KIWIPANEL_DOWNLOAD_URL="$panel_url"
    KIWIPANEL_AGENT_DOWNLOAD_URL="$agent_url"
    KIWIPANEL_SCAFFOLD_URL="$scaffold_url"
    ValidateRequiredArtifactURLs
}

function ValidateRequiredChecksumMetadata() {
    local checksum
    local label
    local field

    for field in SCAFFOLD SHA256 AGENT; do
        case "$field" in
            SCAFFOLD)
                checksum="${KIWIPANEL_SCAFFOLD_SHA256:-}"
                label="Scaffold"
                ;;
            SHA256)
                checksum="${KIWIPANEL_SHA256:-}"
                label="KiwiPanel binary"
                ;;
            AGENT)
                checksum="${KIWIPANEL_AGENT_SHA256:-}"
                label="KiwiPanel agent binary"
                ;;
        esac
        if ! IsValidSHA256Checksum "$checksum"; then
            PrintRed "$label has a missing or invalid SHA-256 checksum in the release catalog"
            return 1
        fi
    done
}

function VerifySHA256Checksum() {
    local file="$1"
    local expected="$2"
    local label="$3"
    local checksum_output
    local actual

    if ! IsValidSHA256Checksum "$expected"; then
        PrintRed "$label has an invalid SHA-256 checksum in the release catalog"
        return 1
    fi
    if ! checksum_output="$(sha256sum "$file" 2>/dev/null)"; then
        PrintRed "Failed to calculate the $label SHA-256 checksum"
        return 1
    fi
    actual="${checksum_output%% *}"

    if [[ "$actual" != "$expected" ]]; then
        PrintRed "$label checksum mismatch!"
        PrintRed "  Expected: $expected"
        PrintRed "  Actual:   $actual"
        LogError "$label checksum mismatch: file=$file expected=$expected actual=$actual"
        return 1
    fi

    PrintGreen "✓ $label checksum verified"
}

function ValidateArchiveStructure() {
    local archive_path="$1"
    local max_depth="${2:-10}"
    local entries
    local entry_count=0
    local filename
    local path_component
    local depth

    LogInfo "Validating archive structure: $archive_path"

    # -Z1 asks Info-ZIP for one exact entry name per line. Unlike parsing
    # `unzip -l`, this preserves spaces and does not depend on display columns.
    if ! entries=$(unzip -Z1 "$archive_path" 2>/dev/null); then
        PrintRed "Archive validation failed: unable to list archive entries"
        LogError "Archive validation failed: unable to list entries: $archive_path"
        return 1
    fi

    while IFS= read -r filename; do
        [[ -z "$filename" ]] && continue
        ((entry_count += 1))

        # Check absolute paths before the required-prefix check so diagnostics
        # identify the exact unsafe condition. Backslashes are forbidden as
        # well, avoiding Windows-path ambiguity in ZIP consumers.
        if [[ "$filename" == /* || "$filename" =~ ^[[:alpha:]]:\\ ]]; then
            PrintRed "Archive validation failed: absolute path detected"
            PrintRed "  Entry: $filename"
            LogError "Archive validation failed: absolute path: $filename"
            return 1
        fi
        if [[ "$filename" == *\\* ]]; then
            PrintRed "Archive validation failed: backslash in path"
            PrintRed "  Entry: $filename"
            LogError "Archive validation failed: backslash in path: $filename"
            return 1
        fi

        # Reject any complete dot or dot-dot component. This prevents both
        # traversal and ambiguous paths that normalize differently by tool.
        local -a path_components=()
        IFS='/' read -r -a path_components <<< "$filename"
        for path_component in "${path_components[@]}"; do
            if [[ "$path_component" == "." || "$path_component" == ".." ]]; then
                PrintRed "Archive validation failed: path traversal detected"
                PrintRed "  Entry: $filename"
                LogError "Archive validation failed: unsafe path component: $filename"
                return 1
            fi
        done

        # Extraction targets /opt/, so every entry must be the top-level
        # kiwipanel directory or one of its descendants.
        if [[ "$filename" != "kiwipanel" && "$filename" != "kiwipanel/" && "$filename" != kiwipanel/* ]]; then
            PrintRed "Archive validation failed: entry outside kiwipanel/ directory"
            PrintRed "  Entry: $filename"
            LogError "Archive validation failed: entry outside kiwipanel/: $filename"
            return 1
        fi

        # Bound path depth to reject pathological archive structures. Exclude a
        # directory's optional trailing slash from the component count.
        depth="${#path_components[@]}"
        if [[ -z "${path_components[depth-1]}" ]]; then
            ((depth -= 1))
        fi
        if (( depth > max_depth )); then
            PrintRed "Archive validation failed: excessive nesting depth ($depth > $max_depth)"
            PrintRed "  Entry: $filename"
            LogError "Archive validation failed: excessive depth ($depth > $max_depth): $filename"
            return 1
        fi
    done <<< "$entries"

    if (( entry_count == 0 )); then
        PrintRed "Archive validation failed: no entries found"
        LogError "Archive validation failed: empty archive"
        return 1
    fi

    LogInfo "Archive validation passed ($entry_count entries)"
    PrintGreen "✓ Archive structure validated ($entry_count entries)"
}

function DownloadPackage() {
    # The complete selected-record identity and all expected hashes must be
    # present and valid before any artifact download. Return, rather than relying
    # on `set -e`, because callers invoke this in conditional contexts where Bash
    # suppresses errexit propagation.
    if ! ValidateRequiredArtifactURLs || ! ValidateRequiredChecksumMetadata; then
        return 1
    fi

    # 1. Download architecture-independent scaffold (scripts, config, systemd, templates)
    PrintInfo "==> Downloading KiwiPanel scaffold"
    PrintInfo "    URL: $KIWIPANEL_SCAFFOLD_URL"
    LogInfo "Scaffold download: version=${KIWIPANEL_VERSION:-unknown} arch=${KIWIPANEL_ARCH:-unknown} url=$KIWIPANEL_SCAFFOLD_URL expected_sha256=${KIWIPANEL_SCAFFOLD_SHA256:-Not provided}"
    if ! curl --proto '=https' --proto-redir '=https' -L --fail --retry 3 --retry-delay 2 "$KIWIPANEL_SCAFFOLD_URL" -o "$TMP_ZIP"; then
        PrintRed "Failed to download KiwiPanel scaffold"
        return 1
    fi

    if [[ ! -s "$TMP_ZIP" ]]; then
        PrintRed "Downloaded scaffold is empty"
        return 1
    fi

    if ! VerifySHA256Checksum "$TMP_ZIP" "$KIWIPANEL_SCAFFOLD_SHA256" "Scaffold"; then
        rm -f "$TMP_ZIP"
        return 1
    fi

    # Validate archive structure before extraction (security hardening)
    if ! ValidateArchiveStructure "$TMP_ZIP"; then
        rm -f "$TMP_ZIP"
        PrintRed "Scaffold archive failed security validation"
        LogError "Scaffold archive validation failed: $TMP_ZIP"
        return 1
    fi

    # 2. Download architecture-specific binary
    PrintInfo "==> Downloading KiwiPanel binary (${KIWIPANEL_ARCH})"

    if [[ -z "${KIWIPANEL_DOWNLOAD_URL:-}" ]]; then
        PrintRed "KIWIPANEL_DOWNLOAD_URL is not set. Did ShowVersion() run?"
        return 1
    fi

    PrintInfo "    URL: $KIWIPANEL_DOWNLOAD_URL"

    if ! curl --proto '=https' --proto-redir '=https' -L --fail --retry 3 --retry-delay 2 "$KIWIPANEL_DOWNLOAD_URL" -o "$TMP_BINARY"; then
        PrintRed "Failed to download KiwiPanel binary"
        return 1
    fi

    if [[ ! -s "$TMP_BINARY" ]]; then
        PrintRed "Downloaded binary is empty"
        return 1
    fi

    # 3. Validate SHA-256 checksum of binary.
    if ! VerifySHA256Checksum "$TMP_BINARY" "$KIWIPANEL_SHA256" "KiwiPanel binary"; then
        rm -f "$TMP_BINARY"
        return 1
    fi

    # 4. Download architecture-specific agent binary
    PrintInfo "==> Downloading KiwiPanel agent binary (${KIWIPANEL_ARCH})"
    PrintInfo "    URL: $KIWIPANEL_AGENT_DOWNLOAD_URL"

    if ! curl --proto '=https' --proto-redir '=https' -L --fail --retry 3 --retry-delay 2 "$KIWIPANEL_AGENT_DOWNLOAD_URL" -o "$TMP_AGENT_BINARY"; then
        PrintRed "Failed to download KiwiPanel agent binary"
        return 1
    fi

    if [[ ! -s "$TMP_AGENT_BINARY" ]]; then
        PrintRed "Downloaded agent binary is empty"
        return 1
    fi

    if ! VerifySHA256Checksum "$TMP_AGENT_BINARY" "$KIWIPANEL_AGENT_SHA256" "KiwiPanel agent binary"; then
        rm -f "$TMP_AGENT_BINARY"
        return 1
    fi

    PrintGreen "✓ All downloads complete"
}

#Make sure the meta data is removed during re-installation
function RemoveMetaData(){
    rm -f "/opt/kiwipanel/meta/passcode"
    rm -f "/opt/kiwipanel/meta/.installed"
}

function PublishBinaryAtomically() {
    local source="$1"
    local destination="$2"
    local mode="$3"
    local staged="${destination}.installing.$$"

    rm -f -- "$staged"
    if ! cp -- "$source" "$staged" || ! chmod "$mode" "$staged" || ! mv -f -- "$staged" "$destination"; then
        rm -f -- "$staged"
        PrintRed "Failed to publish binary atomically: $destination"
        return 1
    fi
}

function ExtractPackage() {
    # 1. Extract scaffold (scripts, config, systemd, templates)
    PrintInfo "==> Extracting scaffold"
    unzip -oq "$TMP_ZIP" -d /opt/ || {
        PrintRed "Failed to extract KiwiPanel scaffold"
        exit 1
    }

    # 2. Install architecture-specific binaries (overwrite any from scaffold).
    # Publish by rename so a legitimate interrupted-install resume remains safe
    # even if the panel step had already started a process from the old inode.
    PrintInfo "==> Installing KiwiPanel binaries (${KIWIPANEL_ARCH})"
    local bin_dir="$INSTALL_DIR/bin"
    mkdir -p "$bin_dir"

    PublishBinaryAtomically "$TMP_BINARY" "$bin_dir/kiwipanel" 755
    PrintGreen "✓ kiwipanel binary installed (${KIWIPANEL_ARCH})"

    PublishBinaryAtomically "$TMP_AGENT_BINARY" "$bin_dir/kiwipanel-agent" 755
    PrintGreen "✓ kiwipanel-agent binary installed (${KIWIPANEL_ARCH})"

    RemoveMetaData
}

function CreateGroupAndUser() {
    PrintInfo "==> Creating kiwisecure group"
    getent group kiwisecure >/dev/null || groupadd kiwisecure
    PrintInfo "==> Creating kiwipanel user"
    if ! id kiwipanel >/dev/null 2>&1; then
        useradd --system \
            --no-create-home \
            --home-dir "$INSTALL_DIR" \
            --shell /usr/sbin/nologin \
            --gid kiwisecure \
            kiwipanel
    fi

    # Ensure kiwipanel user is in kiwisecure group (for reading token file and socket access)
    usermod -aG kiwisecure kiwipanel 2>/dev/null || true

    # Add kiwipanel user to systemd-journal group (for reading agent logs via journalctl)
    if getent group systemd-journal >/dev/null 2>&1; then
        usermod -aG systemd-journal kiwipanel 2>/dev/null || true
        PrintGreen "✓ kiwipanel user added to systemd-journal group"
    fi
}

#====================================Start Installing KiwiPanel ====================================
function PrepareDirectories() {
    PrintInfo "==> Preparing directories"
    mkdir -p "$INSTALL_DIR"
}

function ShowVersion() {
    META_DIR="/opt/kiwipanel/meta"
    VERSION_FILE="$META_DIR/version"
    RELEASES_FILE="$META_DIR/releases.json"

    # Raw GitHub responses may be served from a short-lived CDN cache after
    # releases.json is promoted. Cache-bust the catalog so its checksums are
    # selected from the same current response window as the release assets.
    RELEASES_URL="https://raw.githubusercontent.com/kiwipanel/install/refs/heads/main/releases.json?kiwipanel_catalog=$(date +%s)-$$"

    # Default to stable channel (can be overridden by environment variable)
    CHANNEL="${KIWIPANEL_CHANNEL:-stable}"

    mkdir -p "$META_DIR"

    # Always fetch fresh releases catalog (don't rely on cached file during partial installs)
    # This ensures resumed installations get the latest version, not stale cached data
    if ! RELEASES_JSON=$(curl -fsSL --retry 3 --retry-delay 2 "$RELEASES_URL" 2>/dev/null); then
        PrintRed "Failed to fetch releases.json from GitHub"
        exit 1
    fi

    local catalog_sha256
    catalog_sha256=$(printf '%s' "$RELEASES_JSON" | sha256sum | awk '{print $1}')
    LogInfo "Release catalog fetched: url=$RELEASES_URL sha256=$catalog_sha256 bytes=${#RELEASES_JSON}"

    # Validate JSON is not empty
    if [[ -z "$RELEASES_JSON" || "$RELEASES_JSON" == "null" ]]; then
        PrintRed "Empty or invalid releases.json received"
        exit 1
    fi

    # Cache full releases.json locally (replaceable cache)
    echo "$RELEASES_JSON" > "$RELEASES_FILE"

    # Detect OS
    OS="linux"

    # Detect architecture
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64) ARCH="amd64" ;;
        aarch64|arm64) ARCH="arm64" ;;
        *)
            PrintRed "Unsupported architecture: $ARCH"
            exit 1
            ;;
    esac

    # Get latest version string from the specified channel
    LATEST_VERSION=$(echo "$RELEASES_JSON" | jq -r --arg channel "$CHANNEL" '.channels[$channel].latest // empty')

    # Check if LATEST_VERSION is empty or null
    if [[ -z "$LATEST_VERSION" || "$LATEST_VERSION" == "null" ]]; then
        PrintRed "Failed to parse 'latest' version for channel '$CHANNEL' from releases.json"
        PrintInfo "Available channels:"
        echo "$RELEASES_JSON" | jq -r '.channels | keys[]' 2>/dev/null || true
        exit 1
    fi

    PrintInfo "==> Channel: $CHANNEL"
    PrintInfo "==> Latest version: $LATEST_VERSION"

    # Select exactly one release record. One record is the source of all three
    # direct URLs, checksums, version, OS, and architecture; duplicate matching
    # records are ambiguous and fail closed rather than mixing their metadata.
    if ! RELEASE=$(printf '%s' "$RELEASES_JSON" | jq -ce \
        --arg os "$OS" \
        --arg arch "$ARCH" \
        --arg ver "$LATEST_VERSION" \
        --arg channel "$CHANNEL" '
        [.releases[] | select(.version == $ver and .channel == $channel and .os == $os and .arch == $arch)]
        | if length == 1 then .[0] else empty end
    '); then
        PrintRed "No unique compatible release found for $OS/$ARCH (channel: $CHANNEL, version: $LATEST_VERSION)"
        PrintInfo "Available releases:"
        echo "$RELEASES_JSON" | jq -r '.releases[] | "\(.version) [\(.channel)] - \(.os)/\(.arch)"' 2>/dev/null || true
        exit 1
    fi

    if ! ValidateSelectedReleaseIdentity "$RELEASE" "$LATEST_VERSION" "$OS" "$ARCH"; then
        PrintRed "Release catalog has missing, non-string, or incompatible release identity metadata"
        exit 1
    fi

    VERSION="$KIWIPANEL_VERSION"
    URL="$KIWIPANEL_DOWNLOAD_URL"
    NOTES=$(echo "$RELEASE" | jq -r '.notes // "No release notes"')
    RELEASE_DATE=$(echo "$RELEASE" | jq -r '.release_date // "Unknown"')
    if ! SHA256="$(ReadRequiredReleaseSHA256 "$RELEASE" "sha256")"; then
        PrintRed "KiwiPanel binary has a missing, non-string, or invalid SHA-256 checksum in the release catalog"
        exit 1
    fi
    if ! AGENT_SHA256="$(ReadRequiredReleaseSHA256 "$RELEASE" "agent_sha256")"; then
        PrintRed "KiwiPanel agent binary has a missing, non-string, or invalid SHA-256 checksum in the release catalog"
        exit 1
    fi
    if ! SCAFFOLD_SHA256="$(ReadRequiredReleaseSHA256 "$RELEASE" "scaffold_sha256")"; then
        PrintRed "Scaffold has a missing, non-string, or invalid SHA-256 checksum in the release catalog"
        exit 1
    fi

    # Write plain-text version pointer (authoritative)
    echo "$VERSION" > "$VERSION_FILE"

    echo "Channel         : $CHANNEL"
    echo "Latest Version  : $VERSION"
    echo "Release Date    : $RELEASE_DATE"
    echo "Architecture    : $ARCH"
    echo "Binary SHA256   : $SHA256"
    echo "Agent SHA256    : $AGENT_SHA256"
    echo "Scaffold SHA256 : $SCAFFOLD_SHA256"
    echo "Notes           : $NOTES"
    LogInfo "Release selected: channel=$CHANNEL version=$VERSION os=$OS arch=$ARCH binary_url=$KIWIPANEL_DOWNLOAD_URL agent_url=$KIWIPANEL_AGENT_DOWNLOAD_URL scaffold_url=$KIWIPANEL_SCAFFOLD_URL scaffold_sha256=$SCAFFOLD_SHA256 catalog_sha256=$catalog_sha256"

    # Export the complete identity selected from one catalog record. Never derive
    # companion asset URLs by substituting strings into another artifact URL.
    export KIWIPANEL_VERSION
    export KIWIPANEL_DOWNLOAD_URL
    export KIWIPANEL_AGENT_DOWNLOAD_URL
    export KIWIPANEL_SCAFFOLD_URL
    export KIWIPANEL_ARCH
    export KIWIPANEL_OS
    export KIWIPANEL_CHANNEL="$CHANNEL"
    export KIWIPANEL_SHA256="$SHA256"
    export KIWIPANEL_AGENT_SHA256="$AGENT_SHA256"
    export KIWIPANEL_SCAFFOLD_SHA256="$SCAFFOLD_SHA256"
}
#------------------------------------------------------------Fixing ownership and permissions
function FixPermissions() {
    PrintInfo "==> Setting root-controlled code and panel-owned mutable paths"

    # Root executes the panel binary during update apply. Every code-path
    # ancestor therefore remains root-controlled; never use a recursive panel
    # chown on the installation root.
    chown root:root "$INSTALL_DIR"
    chmod 755 "$INSTALL_DIR"
    for protected_dir in bin scripts systemd templates; do
        if [[ -d "$INSTALL_DIR/$protected_dir" ]]; then
            chown -R root:root "$INSTALL_DIR/$protected_dir"
            find "$INSTALL_DIR/$protected_dir" -type d -exec chmod 755 {} \;
            find "$INSTALL_DIR/$protected_dir" -type f -exec chmod 644 {} \;
        fi
    done

    mkdir -p "$INSTALL_DIR/bin"
    chown root:root "$INSTALL_DIR/bin"
    chmod 755 "$INSTALL_DIR/bin"
    chown root:root "$INSTALL_DIR/bin/kiwipanel"
    chmod 755 "$INSTALL_DIR/bin/kiwipanel"
    if [[ -f "$INSTALL_DIR/bin/kiwipanel-agent" ]]; then
        chown root:root "$INSTALL_DIR/bin/kiwipanel-agent"
        chmod 755 "$INSTALL_DIR/bin/kiwipanel-agent"
    fi

    # The panel may modify application configuration, data, logs, and runtime
    # metadata. meta is intentionally mutable: it stores the passcode,
    # terminal/support tokens, maintenance flag, and version state. It never
    # belongs in the root execution trust chain; trusted update state remains
    # under root-private /var/lib/kiwipanel/update/trusted.
    for mutable_dir in config data logs meta; do
        if [[ -d "$INSTALL_DIR/$mutable_dir" ]]; then
            chown -R kiwipanel:kiwisecure "$INSTALL_DIR/$mutable_dir"
            find "$INSTALL_DIR/$mutable_dir" -type d -exec chmod 750  \;
            find "$INSTALL_DIR/$mutable_dir" -type f -exec chmod 640 {} \;
        fi
    done

    # SSL certificates: panel needs to read them (kiwipanel:kiwisecure ownership).
    # The directory structure is root-controlled but the cert/key files themselves
    # are panel-readable. The SSL generation script sets ownership; we preserve it.
    if [[ -d "$INSTALL_DIR/ssl" ]]; then
        chown -R root:root "$INSTALL_DIR/ssl"
        find "$INSTALL_DIR/ssl" -type d -exec chmod 755 {} \;
        # Restore panel ownership on actual certificate/key files
        find "$INSTALL_DIR/ssl" -type f \( -name "*.crt" -o -name "*.key" -o -name "*.pem" \) \
            -exec chown kiwipanel:kiwisecure {} \;
        find "$INSTALL_DIR/ssl" -type f -name "*.key" -exec chmod 600 {} \;
        find "$INSTALL_DIR/ssl" -type f ! -name "*.key" -exec chmod 644 {} \;
    fi
}

function FixScriptPermissions() {
    local SCRIPT_DIR="$INSTALL_DIR/scripts"
    if [[ -d "$SCRIPT_DIR" ]]; then
        chown -R root:root "$SCRIPT_DIR"
        find "$SCRIPT_DIR" -type d -exec chmod 755 {} \;
        find "$SCRIPT_DIR" -type f -exec chmod 755 {} \;
    fi
}

function MarkInstallationStarted() {
    local marker="$INSTALL_STATE_DIR/.installing"
    local tmp_marker="$marker.tmp"

    printf '%s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" > "$tmp_marker"
    chmod 600 "$tmp_marker"
    mv "$tmp_marker" "$marker"
}

function EnsureInstallStateDirectory() {
    local state_dir="$INSTALL_STATE_DIR"

    if [[ -L "$state_dir" || ( -e "$state_dir" && ! -d "$state_dir" ) ]]; then
        PrintRed "Installer state path is not a trusted directory: $state_dir"
        return 1
    fi

    if [[ ! -e "$state_dir" ]]; then
        if ! mkdir -p -- "$state_dir" || \
           ! chown root:root "$state_dir" || \
           ! chmod 700 "$state_dir"; then
            PrintRed "Failed to create secure installer state directory: $state_dir"
            return 1
        fi
        return 0
    fi

    local identity=""
    if ! identity="$(stat -c '%u|%g|%a' -- "$state_dir" 2>/dev/null)"; then
        PrintRed "Cannot inspect installer state directory: $state_dir"
        return 1
    fi

    if [[ "$identity" != "0|0|700" ]]; then
        PrintRed "Unsafe installer state directory: $state_dir (observed ${identity//|/ }, expected 0 0 700)"
        PrintRed "Refusing to repair existing installer state automatically; verify its contents before restoring root:root/0700"
        return 1
    fi
}

function CreateSystemDirectories() {
    PrintInfo "==> Creating KiwiPanel system directories"
    mkdir -p /etc/kiwipanel /var/log/kiwipanel /var/lib/kiwipanel /run/kiwipanel
    EnsureInstallStateDirectory

    # Root is the sole writer of update state. Legacy panel-writable artifacts
    # are deliberately not migrated into the trusted staging tree.
    mkdir -p /var/lib/kiwipanel/update/trusted/stages
    mkdir -p /var/lib/kiwipanel/panel-state
    mkdir -p /var/lib/kiwipanel/uploads
    install -o root -g kiwisecure -m 0640 /dev/null /var/lib/kiwipanel/update/status.json

    # Preserve a valid per-host CSRF key when upgrading from releases that kept
    # runtime state below /opt. The old metadata tree is root-controlled after
    # extraction, so migration is performed here as root before systemd starts
    # the unprivileged panel. Never overwrite an already-migrated destination.
    local legacy_csrf_key="$INSTALL_DIR/meta/csrf.key"
    local csrf_key="/var/lib/kiwipanel/panel-state/csrf.key"
    if [[ ! -e "$csrf_key" && -f "$legacy_csrf_key" && ! -L "$legacy_csrf_key" ]]; then
        if [[ "$(stat -c '%s' -- "$legacy_csrf_key" 2>/dev/null || printf '0')" == "32" ]]; then
            install -o kiwipanel -g kiwisecure -m 0600 -- "$legacy_csrf_key" "$csrf_key"
            rm -f -- "$legacy_csrf_key"
            PrintInfo "Migrated legacy CSRF key to panel runtime state"
        else
            PrintWarn "Legacy CSRF key has an invalid size; leaving it untouched and generating a new runtime key"
        fi
    fi

    chown root:kiwisecure /etc/kiwipanel /var/lib/kiwipanel /var/lib/kiwipanel/update /run/kiwipanel
    chown -R root:root /var/lib/kiwipanel/update/trusted
    chown -R kiwipanel:kiwisecure /var/log/kiwipanel /var/lib/kiwipanel/panel-state /var/lib/kiwipanel/uploads
    chmod 750 /etc/kiwipanel /var/log/kiwipanel /var/lib/kiwipanel /var/lib/kiwipanel/update /var/lib/kiwipanel/panel-state /run/kiwipanel
    chmod 770 /var/lib/kiwipanel/uploads
    chmod 700 /var/lib/kiwipanel/update/trusted /var/lib/kiwipanel/update/trusted/stages
    [[ ! -f "$csrf_key" ]] || chmod 600 "$csrf_key"
}

function FetchingInstallScripts(){
    PrintInfo "Fetching KiwiPanel installation script."
    PrepareDirectories
    CreateGroupAndUser
    CreateSystemDirectories
    MarkInstallationStarted
    if ! ShowVersion; then
        return 1
    fi
    if ! DownloadPackage; then
        return 1
    fi
    if ! ExtractPackage; then
        return 1
    fi
    FixPermissions
    FixScriptPermissions
}

if ! FetchingInstallScripts; then
    exit 1
fi

source "/opt/kiwipanel/scripts/kiwi"

InstallFirstKiwiBinary
InstallAgentBinary

# Detect the system's architecture
ARCHITECTURE=$(uname -m)
#

kiwipanel_d_start_time=$(date +%s)
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' #NC: Not color: reset color to the default

GetPublicIP() {
    local ip
    # Try public IP lookup services (in order), each with a short timeout
    for url in "https://myip.cpanel.net" "https://ifconfig.me" "https://icanhazip.com"; do
        ip=$(curl -s -4 --connect-timeout 5 --max-time 8 "$url" 2>/dev/null | tr -d '[:space:]')
        if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
            echo "$ip"
            return 0
        fi
    done

    # Fallback: local IP via hostname -I
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "$ip"
        return 0
    fi

    return 1
}

IPADDRESS=$(GetPublicIP)
if [[ -z "$IPADDRESS" ]]; then
    IPADDRESS="<YOUR_SERVER_IP>"
fi
DIR=$(pwd)

source "/opt/kiwipanel/scripts/utility"
source "/opt/kiwipanel/scripts/checksystem"
source "/opt/kiwipanel/scripts/checkscript"
CheckSystemRequirements

###################################################################################
function CheckArchitecture() {
    PrintInfo "==> Checking architechture. Kiwipanel supports 64 bits system only!"
    # Ref: https://raw.githubusercontent.com/runtipi/runtipi/master/scripts/install.sh
    # Not supported on 32 bits systems.
    # Note: aarch64 [ARM 64-bit (also known as AArch64), armv7: 32-bit ARM]
    local ARCHITECTURE="$(uname -m)"
    if [[ "$ARCHITECTURE" == "armv7"* ]] || [[ "$ARCHITECTURE" == "i686" ]] || [[ "$ARCHITECTURE" == "i386" ]]; then
        PrintRed "KiwiPanel currently does not support the 32 bits systems"
        exit 1
    fi
}

# =========================
# OS Detection (refactored)
# =========================

function LoadOsRelease() {
    local file="${1:-/etc/os-release}"

    if [[ ! -f "$file" ]]; then
        echo "ERROR: Cannot detect operating system (missing /etc/os-release)" >&2
        exit 1
    fi

    # Method: Use grep and cut (most reliable)
    OS_ID=$(grep '^ID=' "$file" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs)
    VERSION_ID=$(grep '^VERSION_ID=' "$file" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs)
    OS_VERSION_MAJOR="${VERSION_ID%%.*}"
    OS_LIKE=$(grep '^ID_LIKE=' "$file" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs || echo "")
    OS_NAME=$(grep '^PRETTY_NAME=' "$file" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs)

    # Fallback for OS_NAME
    if [[ -z "$OS_NAME" ]]; then
        OS_NAME=$(grep '^NAME=' "$file" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs)
    fi

    # Validate critical variables
    if [[ -z "$OS_ID" ]]; then
        echo "ERROR: Failed to detect OS_ID from $file" >&2
        echo "File contents:" >&2
        cat "$file" >&2
        exit 1
    fi

    if [[ -z "$OS_VERSION_MAJOR" ]]; then
        echo "WARNING: Could not parse VERSION_ID, defaulting to 9" >&2
        OS_VERSION_MAJOR="9"
    fi

    if [[ -z "$OS_NAME" ]]; then
        OS_NAME="$OS_ID $OS_VERSION_MAJOR"
    fi

    # Success message
    if declare -f PrintInfo >/dev/null 2>&1; then
        PrintInfo "==> Detected: $OS_NAME (ID: $OS_ID, Version: $OS_VERSION_MAJOR)"
    else
        echo "Detected: $OS_NAME (ID: $OS_ID, Version: $OS_VERSION_MAJOR)"
    fi

    # Debug logging
    if [[ "${DEBUG:-0}" == "1" ]]; then
        echo "DEBUG: OS_ID=[$OS_ID]" >&2
        echo "DEBUG: OS_VERSION_MAJOR=[$OS_VERSION_MAJOR]" >&2
        echo "DEBUG: OS_LIKE=[$OS_LIKE]" >&2
        echo "DEBUG: OS_NAME=[$OS_NAME]" >&2
    fi
}

function CheckOs() {
    PrintInfo "==> Checking operating system compatibility..."

    LoadOsRelease

    PrintInfo "==> Detected OS: ${OS_NAME}"
    PrintInfo "==> Kernel: $(uname -r)"

    # ---- Reject CentOS Stream explicitly ----
    if [[ "$OS_ID" == "centos" && "$OS_NAME" =~ Stream ]]; then
        PrintRed "CentOS Stream is not supported."
        PrintRed "Please use Rocky Linux or AlmaLinux instead."
        exit 1
    fi

    case "${OS_ID}" in
        debian)
            if (( OS_VERSION_MAJOR < 11 )); then
                PrintRed "Debian ${VERSION_ID} is not supported."
                PrintRed "Please use Debian 11, 12, or 13."
                exit 1
            fi
            ;;
        ubuntu)
            if (( OS_VERSION_MAJOR < 22 )); then
                PrintRed "Ubuntu ${VERSION_ID} is not supported."
                PrintRed "Please use Ubuntu 22.04 or newer."
                exit 1
            fi
            ;;
        rhel|rocky|almalinux|ol|cloudlinux|vzlinux)
            if (( OS_VERSION_MAJOR < 9 )); then
                PrintRed "${OS_NAME} (version ${OS_VERSION_MAJOR}) is not supported."
                PrintRed "KiwiPanel requires systemd 249+ which is not available on EL8 distributions."
                PrintRed "Please use version 9 or newer (Rocky Linux 9, AlmaLinux 9, RHEL 9, etc.)."
                exit 1
            fi
            ;;
        *)
            if [[ "${OS_LIKE}" == *"rhel"* ]]; then
                if (( OS_VERSION_MAJOR < 9 )); then
                    PrintRed "${OS_NAME} (version ${OS_VERSION_MAJOR}) is not supported."
                    PrintRed "KiwiPanel requires systemd 249+. Please use version 9 or newer."
                    exit 1
                fi
            else
                PrintRed "Unsupported operating system."
                PrintRed "Supported: Debian 11+, Ubuntu 22.04+, Rocky/Alma/RHEL 9+"
                exit 1
            fi
            ;;
    esac

    PrintGreen "✔ Operating system is supported."
}

#Check port https://ping.eu/port-chk/
function CheckPortUsage() {
    local port="$1"
    PrintInfo "==> Checking port $port..."
    if ss -tuln | awk '{print $5}' | grep -q ":$port$"; then
        echo "❌ Port $port is already in use. KiwiPanel needs this port."
        return 1
    fi
    PrintGreen "✔ Port $port is free."
}


function CheckSystemdVersion() {
    PrintInfo "==> Checking systemd version..."
    local MIN_SYSTEMD_VERSION=249

    if ! command -v systemctl >/dev/null 2>&1; then
        PrintRed "systemctl not found. KiwiPanel requires systemd ${MIN_SYSTEMD_VERSION}+."
        exit 1
    fi

    local systemd_ver
    systemd_ver=$(systemctl --version 2>/dev/null | head -1 | grep -oP 'systemd\s+\K\d+' || echo "0")

    if [[ -z "$systemd_ver" || "$systemd_ver" -eq 0 ]]; then
        PrintRed "Failed to detect systemd version."
        exit 1
    fi

    if (( systemd_ver < MIN_SYSTEMD_VERSION )); then
        PrintRed "systemd ${systemd_ver} is too old. KiwiPanel requires systemd ${MIN_SYSTEMD_VERSION}+."
        PrintRed "Your system's systemd does not support required security features."
        PrintRed "Please upgrade to a newer OS (e.g., Rocky/AlmaLinux 9, Debian 12, Ubuntu 22.04)."
        exit 1
    fi

    PrintGreen "✔ systemd ${systemd_ver} (>= ${MIN_SYSTEMD_VERSION})"
}

function CheckConditionBeforeInstall() {
    PrintInfo "==> Evaluating your VPS before installing KiwiPanel....."
    CheckOs
    CheckSystemdVersion
    CheckArchitecture
    CheckPanelScript
    CheckPortUsage 8443 || exit 1
}

#------------------------------------------------------------Create passcode to protect login page
function GenerateThePasscode() {
    local META_DIR="/opt/kiwipanel/meta"
    local PASSCODE_FILE="$META_DIR/passcode"
    local INSTALL_MARKER="$META_DIR/.installed"

    mkdir -p "$META_DIR"

    if [[ -f "$INSTALL_MARKER" && -f "$PASSCODE_FILE" ]]; then
        kiwipanel_passcode=$(tr -d '\n' < "$PASSCODE_FILE")
        PrintGreen "✔ Existing passcode preserved."
        return
    fi

    kiwipanel_passcode=$(GenerateRandomString)
    printf '%s\n' "$kiwipanel_passcode" > "$PASSCODE_FILE"

    chown kiwipanel:kiwisecure "$PASSCODE_FILE"
    chmod 640 "$PASSCODE_FILE"

    if [[ "$FULL_INSTALL" == 1 ]]; then
        touch "$INSTALL_MARKER"
        chown kiwipanel:kiwisecure "$INSTALL_MARKER"
        chmod 640 "$INSTALL_MARKER"
    fi

    PrintGreen "✔ New passcode generated."
}

#------------------------------------------------------------Generate terminal token for global terminal access
# This token is required to access the global (root) terminal via web UI
# SECURITY: We store SHA-256 hash of the token, not the plain text
function GenerateTerminalToken() {
    local META_DIR="/opt/kiwipanel/meta"
    local TOKEN_FILE="$META_DIR/terminal_token"

    mkdir -p "$META_DIR"

    # Always generate a new unique token (don't reuse from package)
    # Generate a secure random 32-character token
    terminal_token=$(head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)

    # Hash the token using SHA-256 before storing
    # IMPORTANT: Use printf to avoid newline issues (echo -n behaves differently on some systems)
    # The plain token is shown to user only once during install
    local token_hash
    token_hash=$(printf '%s' "$terminal_token" | sha256sum | cut -d' ' -f1)

    printf '%s\n' "$token_hash" > "$TOKEN_FILE"

    # Set ownership and permissions
    # Token hash file should be readable by kiwipanel user (for web service)
    chown kiwipanel:kiwisecure "$TOKEN_FILE"
    chmod 640 "$TOKEN_FILE"

    PrintGreen "✔ Terminal token generated (stored as hash)."
}


# #------------------------------------------------------------Installing systemd service file
#------------------------------------------------------------
# Helper: Installs a single unit file (copies, permissions, backup)
#------------------------------------------------------------
function install_unit_file() {
    local unit_name="$1"
    local service_src="$INSTALL_DIR/systemd/$unit_name"
    local service_dst="/etc/systemd/system/$unit_name"

    # Validate source
    if [[ ! -f "$service_src" ]]; then
        PrintRed "Unit file not found: ${service_src}"
        return 1
    fi

    # Backup existing
    if [[ -f "$service_dst" ]]; then
        cp "$service_dst" "${service_dst}.bak"
    fi

    # Copy and set permissions
    cp "$service_src" "$service_dst"
    chmod 644 "$service_dst"
    PrintInfo "Installed unit: $unit_name"
}

#------------------------------------------------------------
# Main Function: Installs and Starts Services
#------------------------------------------------------------
function InstallSystemdService() {
    PrintInfo "==> Installing Systemd Services..."

    # 1. Install the unit files
    install_unit_file "kiwipanel.service" || return 1

    # Only install update service/path if they exist in source
    if [[ -f "$INSTALL_DIR/systemd/kiwipanel-update.service" ]]; then
        install_unit_file "kiwipanel-update.service" || return 1
    fi

    if [[ -f "$INSTALL_DIR/systemd/kiwipanel-update.path" ]]; then
        install_unit_file "kiwipanel-update.path" || return 1
    fi

    # Install the agent service. The always-running service is the sole owner
    # of the Unix socket; the agent creates and guards the listener itself. The
    # legacy kiwipanel-agent.socket unit is intentionally NOT installed.
    if [[ -f "$INSTALL_DIR/systemd/kiwipanel-agent.service" ]]; then
        install_unit_file "kiwipanel-agent.service" || return 1
    fi

    # Convergence for upgrades and repair runs: stop and disable the legacy
    # socket-activation unit before its stale unit file is removed below, so
    # existing hosts never end up with two units claiming one socket lifecycle.
    if systemctl list-unit-files kiwipanel-agent.socket >/dev/null 2>&1; then
        systemctl stop kiwipanel-agent.socket >/dev/null 2>&1 || true
        systemctl disable kiwipanel-agent.socket >/dev/null 2>&1 || true
    fi

    # 2. Reload Daemon (Do this once for all files)
    if ! systemctl daemon-reload; then
        PrintRed "Failed to reload systemd daemon"
        return 1
    fi

    # Remove the stale legacy socket unit after reload and reload again so the
    # service becomes the only unit referencing the socket path.
    if [[ -f "/etc/systemd/system/kiwipanel-agent.socket" ]]; then
        rm -f /etc/systemd/system/kiwipanel-agent.socket
        if ! systemctl daemon-reload; then
            PrintRed "Failed to reload systemd daemon after removing legacy socket"
            return 1
        fi
        PrintInfo "Removed legacy kiwipanel-agent.socket unit"
    fi

    # 3. Enable Services
    PrintInfo "==> Enabling services..."

    if ! systemctl enable kiwipanel.service >/dev/null; then
        PrintRed "Failed to enable kiwipanel.service"
        return 1
    fi

    # The apply service is static and must run only through the trusted path
    # unit or explicit root maintenance, never automatically at boot.
    systemctl disable kiwipanel-update.service >/dev/null 2>&1 || true

    # Enable path unit (it monitors for changes)
    if [[ -f "/etc/systemd/system/kiwipanel-update.path" ]]; then
        if ! systemctl enable kiwipanel-update.path >/dev/null; then
            PrintWarn "Failed to enable kiwipanel-update.path"
        fi
    fi

    # Enable the agent service (the sole socket owner).
    [[ -f "/etc/systemd/system/kiwipanel-agent.service" ]] && \
        systemctl enable kiwipanel-agent.service >/dev/null

    # 4. Start Main Service with Health Checks
    PrintInfo "==> Starting KiwiPanel service..."

    # Stop first to ensure clean restart
    systemctl stop kiwipanel.service 2>/dev/null

    if ! systemctl start kiwipanel.service; then
        PrintRed "Failed to start service"
        systemctl status kiwipanel.service --no-pager || true
        journalctl -u kiwipanel.service -n 20 --no-pager || true
        return 1
    fi

    # 5. Start path unit to begin monitoring
    if [[ -f "/etc/systemd/system/kiwipanel-update.path" ]]; then
        PrintInfo "==> Starting update monitor..."
        if ! systemctl start kiwipanel-update.path; then
            PrintWarn "Failed to start kiwipanel-update.path (auto-updates may not work)"
        else
            PrintGreen "✓ Update monitor started"
        fi
    fi

    # Start the agent service. It is the sole owner of /run/kiwipanel/agent.sock
    # (root:kiwisecure 0660) and creates the listener itself; socket activation
    # is not used.
    if [[ -f "/etc/systemd/system/kiwipanel-agent.service" ]]; then
        systemctl start kiwipanel-agent.service && PrintGreen "✓ Agent service started"
    fi

    # 6. Wait for service to be ready
    PrintInfo "==> Waiting for service to become ready..."
    local timeout=60
    local elapsed=0
    local state=""

    while (( elapsed < timeout )); do
        if systemctl is-active --quiet kiwipanel.service; then
            # Double check: wait 1s and check again to ensure it didn't crash immediately.
            sleep 1
            if systemctl is-active --quiet kiwipanel.service; then
                PrintGreen "✓ KiwiPanel service started successfully (${elapsed}s)"
                return 0
            fi
        fi

        # A terminal failed state cannot recover without another systemd start
        # attempt. Report it immediately instead of hiding the cause behind a
        # misleading 60-second timeout.
        state="$(systemctl show --property=ActiveState --value kiwipanel.service 2>/dev/null || true)"
        if [[ "$state" == "failed" ]]; then
            PrintRed "KiwiPanel service entered failed state during startup"
            systemctl status kiwipanel.service --no-pager || true
            PrintInfo "Recent logs:"
            journalctl -u kiwipanel.service -n 50 --no-pager || true
            return 1
        fi

        sleep 1
        ((elapsed++))
    done

    # Timeout reached
    PrintWarn "⚠ Service did not become active within ${timeout}s (state=${state:-unknown})"
    systemctl status kiwipanel.service --no-pager || true
    PrintInfo "Recent logs:"
    journalctl -u kiwipanel.service -n 50 --no-pager || true
    return 1
}

function Cleanup() {
    rm -f "$TMP_ZIP"
    rm -f "$TMP_BINARY"
    rm -f "$TMP_AGENT_BINARY"
    rm -rf /tmp/kiwipanel-* 2>/dev/null || true

    # Clean up any failed extraction attempts
    if [[ -d /opt/kiwipanel.tmp ]]; then
        rm -rf /opt/kiwipanel.tmp
    fi
}


function DisableSelinuxRuntime() {
    # Only applies to systems with SELinux tools
    if ! command -v getenforce >/dev/null 2>&1; then
        return 0
    fi

    local mode
    mode="$(getenforce 2>/dev/null || echo Disabled)"

    case "$mode" in
        Enforcing|Permissive)
            PrintWarn "Disabling SELinux enforcement (runtime). Consider configuring SELinux policies for production."
            setenforce 0 || true
            ;;
        Disabled)
            PrintInfo "==> SELinux already disabled"
            ;;
        *)
            PrintWarn "Unknown SELinux mode: $mode (ignored)"
            ;;
    esac

    return 0
}


# ------------------------------------------------------------------------------
# Self-Healing: Install systemd drop-in overrides for critical services
# ------------------------------------------------------------------------------
# Adds Restart=always + rate limiting to third-party services (lsws, mariadb)
# so systemd auto-restarts them on crash — even if the panel and agent are down.
# KiwiPanel's own services already have restart policies in their unit files.
# ------------------------------------------------------------------------------
function SetupServiceSelfHealing() {
    PrintInfo "==> Configuring self-healing restart policies..."

    # Services to harden. Only includes services we manage — KiwiPanel's own
    # services (kiwipanel.service, kiwipanel-agent.service) already have
    # Restart=on-failure baked into their unit files.
    local services=()

    # OpenLiteSpeed — detect actual service name (lsws, lshttpd, or openlitespeed)
    for svc in lsws lshttpd openlitespeed; do
        if systemctl list-unit-files "${svc}.service" 2>/dev/null | grep -q "${svc}"; then
            services+=("${svc}")
            break
        fi
    done

    # MariaDB — detect mariadb vs mysql
    for svc in mariadb mysql; do
        if systemctl list-unit-files "${svc}.service" 2>/dev/null | grep -q "${svc}"; then
            services+=("${svc}")
            break
        fi
    done

    # Redis — optional, only if installed
    if systemctl list-unit-files redis-server.service 2>/dev/null | grep -q redis-server; then
        services+=("redis-server")
    elif systemctl list-unit-files redis.service 2>/dev/null | grep -q redis; then
        services+=("redis")
    fi

    if [[ ${#services[@]} -eq 0 ]]; then
        PrintWarn "No third-party services detected for self-healing"
        return 0
    fi

    for service in "${services[@]}"; do
        local override_dir="/etc/systemd/system/${service}.service.d"
        mkdir -p "$override_dir"

        cat > "${override_dir}/kiwipanel-restart.conf" << 'OVERRIDE'
# Installed by KiwiPanel — automatic restart on failure
# See: https://kiwipanel.github.io/docs/self-healing
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=5
OVERRIDE

        chmod 644 "${override_dir}/kiwipanel-restart.conf"
        PrintInfo "  Added restart policy for ${service}"
    done

    # Reload systemd to apply all overrides
    systemctl daemon-reload
    PrintGreen "✓ Self-healing restart policies configured"
}

function VerifyKiwipanel(){
    PrintInfo "==> Verifying ownership"
    local path=""
    local expected_owner=""
    local actual_owner=""
    while IFS='|' read -r path expected_owner; do
        [[ -n "$path" ]] || continue
        actual_owner=$(stat -c "%U:%G" "$path")
        if [[ "$actual_owner" != "$expected_owner" ]]; then
            PrintWarn "$path ownership is $actual_owner (expected $expected_owner)"
        fi
    done <<'EOF'
/opt/kiwipanel|root:root
/opt/kiwipanel/bin|root:root
/opt/kiwipanel/bin/kiwipanel|root:root
/opt/kiwipanel/bin/kiwipanel-agent|root:root
/etc/kiwipanel|root:kiwisecure
/var/log/kiwipanel|kiwipanel:kiwisecure
/var/lib/kiwipanel|root:kiwisecure
/var/lib/kiwipanel/update|root:kiwisecure
/var/lib/kiwipanel/update/trusted|root:root
/var/lib/kiwipanel/uploads|kiwipanel:kiwisecure
/var/lib/kiwipanel/panel-state|kiwipanel:kiwisecure
EOF
}


function SuccessMessage() {
    PrintGreen "✔ KiwiPanel has been successfully installed on your VPS!"
    kiwipanel_d_end_time=$(date +%s)
    elapsed=$((kiwipanel_d_end_time - kiwipanel_d_start_time))
    printf " \n"
    echo "$(tput setaf 2)Total time installed: ${elapsed} seconds.$(tput sgr0)"
    printf " \n"
    echo "$(tput setaf 2)================================Install KiwiPanel Done!==============================$(tput sgr0)"
    echo ""
    echo "   Login at : https://$IPADDRESS:$KIWIPANEL_PORT/$kiwipanel_passcode"
    echo "   User:     ${admin_user}"
    echo "   Password: ${admin_pass}"
    echo ""
    echo "$(tput setaf 3)   ⚠️  IMPORTANT - Save these credentials now!$(tput sgr0)"
    echo ""
    echo "   Rescue Token: ${terminal_token}"
    echo "   (This token is shown ONLY ONCE. Use it at System > Terminal or System > File Manager to access the root server.)"
    echo "   To rotate: kiwipanel terminal rotate"
    echo ""
    echo "   Database credentials are stored in root-only file: /etc/kiwipanel/secrets.env"
    echo ""
    echo "$(tput setaf 2)=====================================================================================$(tput sgr0)"
    LogInfo "Installation completed successfully"
}


source "/opt/kiwipanel/scripts/wrapper"

function InstallKiwipanel() {
    local config_file="/opt/kiwipanel/config/kiwipanel.toml"
    if [[ ! -f "$config_file" ]]; then
        if ! StepSelected config; then
            PrintRed "Config prerequisite disappeared; refusing an implicit config install"
            return 1
        fi
        PrintWarn "Config file not found, generating now..."
        WriteToConfig || {
            PrintRed "Failed to generate config file"
            return 1
        }
    fi
    InstallWrapper
    DisableDefaultMotd
    GenerateThePasscode
    GenerateTerminalToken
    InstallSystemdService
    InstallLoginBanner
}

