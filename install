#================================= Fetching source file from github=================================

readonly FIREWALL_HELPER_PATH="${KIWIPANEL_FIREWALL_HELPER_PATH:-/opt/kiwipanel/scripts/firewall}"
FIREWALL_HELPER_SHA256_AT_SOURCE=""
FIREWALL_RUNTIME_FUNCTION_MANIFEST_AT_SOURCE=""

function ComputeFileSHA256() {
    local checksum_output

    if ! checksum_output="$(sha256sum "$1" 2>/dev/null)"; then
        return 1
    fi
    printf '%s\n' "${checksum_output%% *}"
}

function ComputeBashFunctionSHA256() {
    local function_name="$1"
    local definition
    local checksum_output

    if ! definition="$(declare -f "$function_name")" || [[ -z "$definition" ]]; then
        return 1
    fi
    if ! checksum_output="$(printf '%s\n' "$definition" | sha256sum)"; then
        return 1
    fi
    printf '%s\n' "${checksum_output%% *}"
}

function ComputeFirewallRuntimeFunctionManifest() {
    local function_names
    local function_name
    local function_sha256

    if ! function_names="$(sed -nE 's/^function ([A-Za-z_][A-Za-z0-9_]*)\(\)[[:space:]]*\{.*$/\1/p' "$FIREWALL_HELPER_PATH")" \
        || [[ -z "$function_names" ]]; then
        return 1
    fi

    while IFS= read -r function_name; do
        if ! function_sha256="$(ComputeBashFunctionSHA256 "$function_name")"; then
            return 1
        fi
        printf '%s.sha256=%s\n' "$function_name" "$function_sha256"
    done <<< "$function_names"
}

function CaptureFirewallRuntimeProvenance() {
    local helper_mtime="unknown"
    local manifest_checksum_output
    local manifest_sha256

    if ! FIREWALL_HELPER_SHA256_AT_SOURCE="$(ComputeFileSHA256 "$FIREWALL_HELPER_PATH")"; then
        PrintRed "Failed to hash the sourced firewall helper"
        return 1
    fi
    if ! FIREWALL_RUNTIME_FUNCTION_MANIFEST_AT_SOURCE="$(ComputeFirewallRuntimeFunctionManifest)"; then
        PrintRed "Failed to hash the sourced firewall helper functions"
        return 1
    fi
    if ! manifest_checksum_output="$(printf '%s\n' "$FIREWALL_RUNTIME_FUNCTION_MANIFEST_AT_SOURCE" | sha256sum)"; then
        PrintRed "Failed to hash the firewall runtime function manifest"
        return 1
    fi
    manifest_sha256="${manifest_checksum_output%% *}"
    helper_mtime="$(stat -c '%y' "$FIREWALL_HELPER_PATH" 2>/dev/null || printf '%s' 'unknown')"

    LogInfo "Firewall helper sourced: path=$FIREWALL_HELPER_PATH sha256=$FIREWALL_HELPER_SHA256_AT_SOURCE mtime=$helper_mtime runtime_functions.sha256=$manifest_sha256"
}

function VerifyFirewallRuntimeProvenance() {
    local current_helper_sha256
    local current_function_manifest
    local manifest_checksum_output
    local manifest_sha256

    if ! current_helper_sha256="$(ComputeFileSHA256 "$FIREWALL_HELPER_PATH")"; then
        PrintRed "Failed to hash the firewall helper before execution"
        return 1
    fi
    if [[ "$current_helper_sha256" != "$FIREWALL_HELPER_SHA256_AT_SOURCE" ]]; then
        PrintRed "Firewall helper changed after it was sourced; refusing to continue"
        return 1
    fi

    if ! current_function_manifest="$(ComputeFirewallRuntimeFunctionManifest)"; then
        PrintRed "Failed to verify firewall helper runtime functions"
        return 1
    fi
    if ! manifest_checksum_output="$(printf '%s\n' "$current_function_manifest" | sha256sum)"; then
        PrintRed "Failed to hash the current firewall runtime function manifest"
        return 1
    fi
    manifest_sha256="${manifest_checksum_output%% *}"
    LogInfo "Firewall helper before execution: file.sha256=$current_helper_sha256 runtime_functions.sha256=$manifest_sha256"

    if [[ "$current_function_manifest" != "$FIREWALL_RUNTIME_FUNCTION_MANIFEST_AT_SOURCE" ]]; then
        LogError "Expected firewall runtime functions: $(printf '%s' "$FIREWALL_RUNTIME_FUNCTION_MANIFEST_AT_SOURCE" | tr '\n' ' ')"
        LogError "Current firewall runtime functions: $(printf '%s' "$current_function_manifest" | tr '\n' ' ')"
        PrintRed "Firewall runtime function changed after the helper was sourced; refusing to continue"
        return 1
    fi
}

source "/opt/kiwipanel/scripts/loginbanner"
source "/opt/kiwipanel/scripts/welcome"
source "/opt/kiwipanel/scripts/mariadb"
if ! source "$FIREWALL_HELPER_PATH"; then
    PrintRed "Failed to source firewall helper: $FIREWALL_HELPER_PATH"
    exit 1
fi
if ! CaptureFirewallRuntimeProvenance; then
    exit 1
fi
source "/opt/kiwipanel/scripts/kiwipanelssl"
source "/opt/kiwipanel/scripts/base"
source "/opt/kiwipanel/scripts/swap"
source "/opt/kiwipanel/scripts/createadminuser"
source "/opt/kiwipanel/scripts/lsws"

function WriteToConfig(){
    # 1. Set critical variables FIRST
    export KIWIPANEL_ADMIN_USER="admin"  # or your generated value
    export KIWIPANEL_ADMIN_PASS="$kiwipanel_passcode"

    # Load the real DB password generated by InstallAndConfigureMariaDB
    # (stored in /etc/kiwipanel/secrets.env by the mariadb script)
    if [[ -f /etc/kiwipanel/secrets.env ]]; then
        DB_PASS="$(grep '^DB_PASS=' /etc/kiwipanel/secrets.env | cut -d'=' -f2- | tr -d '\n')"
        export DB_PASS
    fi
    if [[ -z "${DB_PASS:-}" ]]; then
        PrintRed "DB_PASS not found in /etc/kiwipanel/secrets.env. Did MariaDB install complete?"
        return 1
    fi

    # 2. Source the scripts
    source "/opt/kiwipanel/scripts/writeconfigdata" || {
        PrintRed "Failed to source writeconfigdata"
        return 1
    }

    source "/opt/kiwipanel/scripts/writeconfig" || {
        PrintRed "Failed to source writeconfig"
        return 1
    }

    # 3. Generate config
    if ! GenerateInitialConfig; then
        PrintRed "Failed to generate configuration file"
        return 1
    fi

    PrintGreen "✓ Configuration file created successfully"
}

# ==============================================================================
# Main Phase: Step Functions + Verify Functions
# ==============================================================================

# Step 5: Base system
step_base_system() { InstallAndConfigureBase; }

verify_base_system() {
    # Cron must be enabled
    ensure_service_active "cron" || ensure_service_active "crond" || return 1
    return 0
}

# Step 6: Swap
step_swap() { CreateSwap; }

verify_swap() {
    # Either swap is active OR system has plenty of RAM (>4GB)
    if swapon --show 2>/dev/null | grep -q '/'; then
        return 0
    fi
    local ram_mb
    ram_mb=$(free -m | awk '/Mem:/ {print $2}')
    if (( ram_mb > 4096 )); then
        return 0  # enough RAM, swap optional
    fi
    return 1
}

# Step 7: Firewall
step_firewall() {
    if ! VerifyFirewallRuntimeProvenance; then
        return 1
    fi
    if ! InstallAndConfigureFirewall; then
        return 1
    fi
    if ! InstallAndConfigureFail2Ban; then
        return 1
    fi
}

verify_firewall() {
    if ! VerifyFirewallRuntimeProvenance; then
        return 1
    fi
    if ! VerifyFirewall; then
        return 1
    fi
    if ! VerifyFail2Ban; then
        return 1
    fi
}

# Step 8: SSL
step_ssl() { InstallAndConfigureSSL; }

verify_ssl() {
    local cert="/opt/kiwipanel/ssl/panel/kiwipanel.crt"
    local key="/opt/kiwipanel/ssl/panel/kiwipanel.key"
    ensure_file_exists "$cert" || return 1
    ensure_file_exists "$key" || return 1
    # Not expired?
    openssl x509 -in "$cert" -checkend 0 &>/dev/null || return 1
    return 0
}

# Step 9: MariaDB
function VerifyMariaDBReleaseProvenance() {
    # Production MariaDB mutation is owned exclusively by the release-scaffold Bash helper.
    local helper="$INSTALL_DIR/scripts/mariadb"
    local adapter="$INSTALL_DIR/scripts/mariadb-platform"
    local scaffold_commit_file="$INSTALL_DIR/meta/scaffold-commit"
    local scaffold_commit

    if [[ ! -r "$helper" ]]; then
        PrintRed "MariaDB provenance gate: production helper missing at $helper"
        return 1
    fi
    if [[ ! -x "$adapter" ]]; then
        PrintRed "MariaDB provenance gate: platform adapter missing or not executable at $adapter"
        return 1
    fi
    if [[ ! -f "$scaffold_commit_file" ]]; then
        PrintRed "MariaDB provenance gate: scaffold commit marker missing at $scaffold_commit_file"
        return 1
    fi
    scaffold_commit=$(head -n 1 "$scaffold_commit_file" 2>/dev/null | tr -d '[:space:]') || return 1
    if [[ ! "$scaffold_commit" =~ ^[0-9a-f]{40}$ ]]; then
        PrintRed "MariaDB provenance gate: scaffold commit has invalid format: $scaffold_commit"
        return 1
    fi
    PrintGreen "✓ MariaDB production helper verified from scaffold commit $scaffold_commit"
}

step_mariadb() {
    VerifyMariaDBReleaseProvenance || return 1
    InstallAndConfigureMariaDB
}

verify_mariadb() {
    CheckMariaDBHealth
}

# Step 10: Config
step_config() { WriteToConfig; }

verify_config() {
    local config="/opt/kiwipanel/config/kiwipanel.toml"
    ensure_file_exists "$config" || return 1
    [[ -s "$config" ]] || return 1  # non-empty
    return 0
}

# Step 11: Panel (systemd, passcode, token, etc.)
step_panel() { InstallKiwipanel; }

verify_panel() {
    ensure_file_exists "/etc/systemd/system/kiwipanel.service" || return 1
    ensure_file_exists "/opt/kiwipanel/meta/passcode" || return 1
    ensure_file_exists "/opt/kiwipanel/meta/terminal_token" || return 1
    ensure_service_active "kiwipanel" || return 1
    return 0
}

# Step 12: OLS
step_ols() {
    InstallLitespeedServer
    VerifyLswsStopped
    UnguardOpenLiteSpeedService
    StartLswsOnce
}

verify_ols() {
    # OLS installed?
    ensure_dir_exists "/usr/local/lsws" || return 1
    # Service active?
    ensure_service_active "lsws" || ensure_service_active "lshttpd" || return 1
    # Port 80 responding?
    ss -tlnp 2>/dev/null | grep -q ':80 ' || return 1
    return 0
}

# Step 13: Finalize
step_finalize() {
    VerifyKiwipanel
    SetupServiceSelfHealing
    PostInstallCheck
    CreateAdminUser
}

verify_finalize() {
    # Panel service must still be running after finalize
    ensure_service_active "kiwipanel" || return 1
    # Admin user creation writes to the database; check the DB file exists
    ensure_file_exists "/opt/kiwipanel/data/kiwipanel.db" || return 1
    # Self-healing drop-in must exist for at least one managed service
    local has_dropin=false
    for svc in lsws lshttpd openlitespeed mariadb mysql; do
        if [[ -f "/etc/systemd/system/${svc}.service.d/kiwipanel-restart.conf" ]]; then
            has_dropin=true
            break
        fi
    done
    if ! $has_dropin; then
        PrintWarn "No self-healing drop-in found for any core service"
        # Non-fatal — don't block install for this
    fi
    return 0
}

# ==============================================================================
# Main
# ==============================================================================
function main() {
    Welcome
    CheckConditionBeforeInstall
    EnsureInstallStateDirectory

    run_step "base_system"  step_base_system  verify_base_system
    run_step "swap"         step_swap         verify_swap
    run_step "firewall"     step_firewall     verify_firewall
    run_step "ssl"          step_ssl          verify_ssl
    run_step "mariadb"      step_mariadb      verify_mariadb
    run_step "config"       step_config       verify_config
    run_step "panel"        step_panel        verify_panel
    run_step "ols"          step_ols          verify_ols
    run_step "finalize"     step_finalize     verify_finalize

    if [[ "$FULL_INSTALL" == 1 ]]; then
        # Finalization (including admin creation) has completed. A failed
        # readiness probe is not an installation-step failure: do not retry,
        # repair, roll back, or remove the completed-step markers.
        local readiness_status=0
        kiwipanel panel readiness || readiness_status=$?
        if [[ "$readiness_status" != 0 ]]; then
            PrintRed "Installation steps completed, but readiness failed (exit $readiness_status). No automatic repair or rollback was attempted."
            return "$readiness_status"
        fi
        SuccessMessage
    else
        PrintGreen "Selected steps completed: $STEPS_FILTER. Partial installation; full installation is not marked complete."
    fi
    Cleanup
}

main
